# DAYFLOW HRMS — Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# NEVER commit .env to version control.

# Supabase project URL (from: Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/publishable key (from: Project Settings → API → Project API keys → anon public)
# This key is safe to expose in frontend code — it is limited by RLS policies.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# The service_role key grants full database bypass.
# It must NEVER be placed in frontend code or committed to git.
# Use it only in server-side scripts, Edge Functions, or CI/CD.
# SUPABASE_SERVICE_ROLE_KEY=
# ------------------------------------------------------------
